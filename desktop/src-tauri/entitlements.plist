<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the WKWebView (JIT-compiled JavaScript). Without this the
	     app crashes under the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The WebView allocates executable memory for JIT; allow it. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Tauri's dev server / debug builds rely on DYLD_* environment variables. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
