    "sql": "the script as a user would run it",
    "statements": "splitStatements/split_statements(sql) — ordered, comment-only fragments dropped",
    "kinds": "classifyStatement/classify_statement of each entry in statements",
    "analysis": "analyzeScript/analyze_script(sql): destructive, 1-based firstDestructiveIndex (null when safe), totalStatements, reason"
