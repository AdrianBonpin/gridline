# Pinned, cryptographically verified inputs for the bundled database tools.
#
# Everything the release pipeline uses to produce
# `desktop/src-tauri/resources/pg_tools/*` and
# `desktop/src-tauri/resources/mysql_tools/*` is declared here: the exact
# version, the exact upstream URL, and the SHA-256 / git commit that was
# reviewed. Nothing else may name an upstream tool host — release.yml has to go
# through `scripts/verified-fetch.sh` (which is the only downloader) and
# `scripts/check-workflows.sh` fails if the workflow talks to an upstream host
# directly.
#
# Rules for changing anything below:
#   * Bump the version and its digest in the SAME commit. A mismatched pair
#     fails the release job before a single byte is extracted or packaged.
#   * Never point an input at a moving target ("latest", a branch, a floating
#     tag). A pin must identify one immutable artifact.
#   * Record where the digest came from, so a future reviewer can re-derive it.
#
# Sourced as shell (`set -a; . scripts/tool-inputs.env; set +a`): plain
# assignments only, no command substitution, no external commands.

# ---------------------------------------------------------------------------
# PostgreSQL client tools (pg_dump / pg_restore / psql)
# ---------------------------------------------------------------------------

# Version reported by the shipped tools; `scripts/verify-bundled-tools.sh`
# fails if a bundled binary does not report it.
PG_TOOLS_VERSION="16.4"

# Upstream source release. Linux and macOS compile the client tools from this
# tarball, so the shipped executables are derived from reviewed source.
# Digest provenance: https://ftp.postgresql.org/pub/source/v16.4/postgresql-16.4.tar.bz2.sha256
# (re-downloaded and re-hashed when this pin was added — it matched).
PG_SOURCE_URL="https://ftp.postgresql.org/pub/source/v16.4/postgresql-16.4.tar.bz2"
PG_SOURCE_SHA256="971766d645aa73e93b9ef4e3be44201b4f45b5477095b049125403f9f3386d6f"

# Windows prebuilt binaries. The PostgreSQL project does not publish Windows
# client binaries itself; EnterpriseDB builds the official installer set used
# by postgresql.org's Windows download page.
# Digest provenance: computed from a fresh download of this exact pinned URL
# when the pin was added (no upstream checksum file is published for it), so a
# re-download here is the way to re-derive it.
PG_WINDOWS_PACKAGE_URL="https://get.enterprisedb.com/postgresql/postgresql-16.4-1-windows-x64-binaries.zip"
PG_WINDOWS_SHA256="3508d8f085bc3980f38211a82e3f31e5fcae9952105d3dc2f8be67b64a822baa"

# ---------------------------------------------------------------------------
# MariaDB client tools (mariadb-dump / mariadb)
# ---------------------------------------------------------------------------

# Version reported by the shipped tools; `scripts/verify-bundled-tools.sh`
# fails if a bundled binary does not report it.
MARIADB_TOOLS_VERSION="11.4.5"

# Linux and macOS build the clients from the upstream git tree, pinned to the
# exact commit the release tag resolves to (annotated tag object
# e2c746b03313677dd880ed7f5ada49c17c8c1b1c, PGP-signed by the MariaDB release
# key — GitHub reports it as an unknown key, so the enforced control is the
# commit pin below: `git rev-parse HEAD` must equal it, and a moved tag or a
# different tree therefore fails the job).
MARIADB_GIT_URL="https://github.com/MariaDB/server.git"
MARIADB_GIT_TAG="mariadb-11.4.5"
MARIADB_GIT_COMMIT="0771110266ff5c04216af4bf1243c65f8c67ccf4"

# Windows prebuilt archive.
# Digest provenance: the version's signed sum file,
# https://archive.mariadb.org/mariadb-11.4.5/winx64-packages/sha256sums.txt
# (detached signature: sha256sums.txt.asc, MariaDB release key).
MARIADB_WINDOWS_PACKAGE_URL="https://archive.mariadb.org/mariadb-11.4.5/winx64-packages/mariadb-11.4.5-winx64.zip"
MARIADB_WINDOWS_SHA256="b7c11d38657f16b837e68199d73670510aadb78f42dfa5d5fdea31a7aab342e3"
